---
import { u } from '../url';
import Base from '../layouts/Base.astro';

const stages = [
  {
    short: 'Introduction',
    title: 'Introduction, Assessment, Workshops, and Demos',
    text: "Valid8 Advisory helps organisations understand what digital identity and verifiable credentials can do for them, and where they fit in the regulatory and technical landscape of their jurisdiction. Through facilitated workshops with leadership and delivery teams, we identify practical use cases, test assumptions about customer and business needs, and establish a shared understanding of the opportunity. The result is a clear scoping report and proposal that gives decision-makers a sound basis to make strategic decisions on how to proceed.",
    items: [
      'Introduction to digital identity and verifiable credentials',
      'Use case identification and development',
      'Exploration of business and customer expectations',
      'Initial scoping reports and proposals',
      'End-to-end technical demonstration',
      'Overview of the Australian, New Zealand and international digital identity context',
    ],
  },
  {
    short: 'Planning',
    title: 'Planning and Governance',
    text: 'Digital identity initiatives cut across technology, policy, legal, and customer functions, and they need governance that reflects that. Valid8 Advisory helps organisations set strategic direction, establish governance arrangements and decision rights, and secure the authorising environment needed to move forward. We develop business cases and benefits plans that stand up to scrutiny from boards, ministers, and investment panels, and programme plans that anticipate the change the initiative will demand.',
    items: [
      'Strategic planning',
      'Governance design and authorising environment',
      'Programme and change management planning',
      'Business case and benefits planning',
    ],
  },
  {
    short: 'Design',
    title: 'Design and Experience',
    text: "Digital identity services must be designed to meet the requirements of the people who will use them and the law that governs them. Valid8 Advisory brings together customer-centred design, architecture that aligns with international standards, and a detailed understanding of the legislative and regulatory settings that apply, such as Australia's Digital ID Act 2024 and, in New Zealand, the Digital Identity Services Trust Framework Act 2023, the Privacy Act 2020, and the Identification Standards. We help organisations shape commercial and operating models that are sustainable, and assess whether the market is ready to deliver what they need.",
    items: [
      'Co-design with customers and stakeholders',
      'Customer experience design',
      'System design and architecture',
      'Legislation, regulation, and policy frameworks',
      'Commercial and operating models',
      'Market readiness and procurement planning',
    ],
  },
  {
    short: 'Procure',
    title: 'Partner, Procure, Operate',
    text: "Valid8 Advisory supports organisations to find and secure the right partners, from understanding who is active in the market through to structuring tenders and negotiating terms. We draw on our knowledge of the Australian, New Zealand and international digital identity markets to help clients assess vendor capability from the global marketplace, consider partnership and shared-service models, and plan how the service will be managed once it's live.",
    items: [
      'Market scan and tender',
      'Joint partnership models',
      'Procurement and negotiation approach',
      'Service management planning',
    ],
  },
  {
    short: 'Launch',
    title: 'Assure, Launch, and Improve',
    text: 'Trust in a digital identity service depends on it being secure, compliant, and well supported from the moment it goes live. Valid8 Advisory helps organisations plan and oversee a testing regime proportionate to the risk, prepare their security and policy settings for regulatory scrutiny, and give decision-makers assurance that the service and its stakeholders are ready. We support the change and communications work that launch demands, and stay involved beyond go-live to track benefits against the investment case and drive continuous improvement.',
    items: [
      'Planning and oversight of security, system, and user acceptance testing, including penetration testing and bug bounty programmes',
      'Information Security Management System (ISMS), policy, and regulatory readiness',
      'Readiness assurance ahead of go-live',
      'Community, industry, and legislative change management',
      'Communications and media planning',
      'Service launch and transition to full service management',
      'Benefits realisation, return on investment, and continuous improvement',
    ],
  },
];

const accreditation = [
  'Maturity and readiness assessment',
  'Service definition and scoping',
  'Independent evaluator strategy, procurement, and co-ordination',
  'Identification management support',
  'Privacy and security support',
  'Provider and governance requirements support',
  'Application compilation and regulator engagement',
  'Support alignment with government digital public infrastructure',
];
---
<Base title="Offerings" active="offerings" description="Digital identity advisory across the full lifecycle, from workshops and business cases to procurement, launch and Trust Framework accreditation.">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">Offerings</div>
        <h1 class="hero-title">Support across the full lifecycle</h1>
        <p class="lede" style="max-width:560px">We support organisations from initial exploration and use case development through business cases, design, procurement, accreditation, and launch. Clients get a single advisory partner who understands how early decisions play out in delivery, and who stays involved to make sure benefits are realised.</p>
      </div>
      <div class="hero-photo"><img src={u("/assets/wallet-phone.jpg")} alt="Digital wallet on a phone" /></div>
    </div>
  </section>

  <nav class="subnav" aria-label="Service stages">
    <div class="wrap subnav-row">
      {stages.map((s, i) => (
        <a href={`#s${i + 1}`}><span class="n">{i + 1}</span>{s.short}</a>
      ))}
      <a href="#s6"><span class="n n-accent">6</span>Accreditation</a>
    </div>
  </nav>

  {stages.map((s, i) => (
    <section id={`s${i + 1}`} class:list={['stage', { ruled: i > 0 }]}>
      <div class="wrap stage-grid">
        <div class="stage-copy">
          <span class="stage-label">STAGE {String(i + 1).padStart(2, '0')}</span>
          <h2 class="h2-sm">{s.title}</h2>
          <p class="body">{s.text}</p>
        </div>
        <div class="included">
          <div class="included-label">What's included</div>
          <ul class="checks">
            {s.items.map((item) => (
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="#1D995B" /><path d="M7 12.5l3.2 3.2L17 9" stroke="#fff" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  ))}

  <section id="s6" class="stage accred">
    <img src={u("/assets/lines-wide.png")} alt="" class="accred-lines" />
    <div class="wrap stage-grid">
      <div class="stage-copy">
        <span class="stage-label on-dark">06 · ACROSS EVERY STAGE</span>
        <h2 class="h2-sm">Trust Framework Accreditation</h2>
        <p class="body on-dark">Accreditation under the Digital Identity Services Trust Framework demonstrates that a provider's services meet New Zealand's requirements for identification management, privacy, and security. Valid8 Advisory helps organisations assess their readiness, define which services to accredit, and prepare the documentation and evidence the Trust Framework Authority expects. We can co-ordinate the independent identification management, privacy, and security evaluations, compile the application, and manage engagement with the regulator through to a decision. This includes agencies issuing credentials through the all-of-government issuance platform.</p>
      </div>
      <div class="included on-dark">
        <div class="included-label">What's included</div>
        <ul class="checks">
          {accreditation.map((item) => (
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="#5ABE82" /><path d="M7 12.5l3.2 3.2L17 9" stroke="#1C334E" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(48px, 7vw, 88px) 0 clamp(48px, 6vw, 72px); overflow: hidden; }
  .hero-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: clamp(40px, 6vw, 72px); align-items: center;
  }
  .hero-copy { display: flex; flex-direction: column; gap: 24px; }
  .hero-title { font-size: clamp(40px, 5.4vw, 64px); line-height: 1.05; letter-spacing: -0.035em; text-wrap: balance; }
  .hero-photo { border-radius: 28px; overflow: hidden; aspect-ratio: 1 / 0.9; background: var(--mint); }
  .hero-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .subnav {
    position: sticky; top: 76px; z-index: 40; background: var(--hdr);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .subnav-row { padding-top: 12px; padding-bottom: 12px; display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; }
  .subnav-row::-webkit-scrollbar { display: none; }
  .subnav a {
    flex: none; display: flex; align-items: center; gap: 8px; padding: 8px 14px 8px 8px; border-radius: 999px;
    background: var(--subtle); color: var(--ink); font-size: 14px; font-weight: 500; text-decoration: none; white-space: nowrap;
  }
  .subnav a:hover { background: var(--mint); color: var(--ink); }
  .n {
    width: 24px; height: 24px; border-radius: 50%; background: var(--btn); color: var(--btn-ink);
    display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600;
  }
  .n-accent { background: var(--green-light); color: var(--navy-deep); }

  .stage { scroll-margin-top: 140px; padding: clamp(56px, 8vw, 96px) 0; }
  .stage.ruled { border-top: 1px solid var(--line); }
  .stage-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(32px, 5vw, 64px); align-items: start;
  }
  .stage-copy { display: flex; flex-direction: column; gap: 20px; }
  .stage-label { font-family: var(--font-display); font-size: 14px; font-weight: 600; color: var(--green); letter-spacing: 0.04em; }
  .included { background: var(--mint); border-radius: 22px; padding: clamp(24px, 3vw, 36px); }
  .included-label { font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--green); margin-bottom: 8px; }
  .checks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .checks li {
    display: flex; gap: 12px; align-items: flex-start; padding: 14px 0;
    border-bottom: 1px solid var(--line3); font-size: 16px; line-height: 1.45;
  }
  .checks li:last-child { padding-bottom: 0; border-bottom: 0; }
  .checks svg { flex: none; margin-top: 1px; }

  .accred { padding: clamp(64px, 9vw, 112px) 0; background: var(--navy); color: #fff; position: relative; overflow: hidden; }
  .accred .wrap { position: relative; }
  .accred-lines { position: absolute; right: -10%; top: 0; width: min(900px, 90%); opacity: 0.16; pointer-events: none; }
  .stage-label.on-dark { color: var(--green-light); }
  .body.on-dark { color: #D5DBE4; }
  .included.on-dark { background: rgba(28, 51, 78, 0.7); border: 1px solid rgba(255, 255, 255, 0.14); }
  .included.on-dark .included-label { color: var(--green-light); }
  .included.on-dark .checks li { border-bottom-color: rgba(255, 255, 255, 0.12); }
</style>

---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const models = [
  { name: 'Single Sign-On', color: '#3B8FD9', text: 'Federated login gateways (OIDC, SAML) that prove who is logging in at the time of a transaction, without issuing a credential the holder keeps.' },
  { name: 'Identity Matching', color: '#E8803A', text: 'A foundational registry checked live against biometrics, OTP or a signed QR. Every verification calls back to the issuer.' },
  { name: 'VC: X.509, ISO mDoc, SD-JWT VC', color: '#1D995B', text: 'Holder-held credentials signed with PKI, including ISO/IEC 18013-5 mobile licences and the EUDI Wallet. Verifiable offline.' },
  { name: 'VC: Blockchain / DLT', color: '#9466E0', text: 'W3C Verifiable Credentials with DIDs and trust anchors on a distributed ledger such as Hyperledger Indy or Ethereum.' },
  { name: 'Hybrid', color: '#E2B42B', text: 'Two or more models live or in pilot in the same country. Hybrid countries are striped in the colours of their components.' },
];
---
<Base title="Digital Identity Atlas" active="atlas" description="An interactive world review of national digital identity and verifiable credential implementations, by model, status, legislation and take-up.">
  <section class="intro">
    <div class="wrap intro-stack">
      <div class="eyebrow">Digital Identity Atlas</div>
      <h1 class="h1" style="max-width:960px">A world review of digital identity and verifiable credentials</h1>
      <p class="lede" style="max-width:740px">How each country identifies people online: the model it uses, whether it is live, the legislation behind it and how many people have taken it up. Hover a country for a summary, or click it for the full profile.</p>
    </div>
  </section>

  <section class="atlas-section">
    <div class="wrap wrap-wide">
      <div id="atlas" class="atlas" data-base={base}>
        <div class="toolbar">
          <div class="regions" id="regions" role="group" aria-label="Region"></div>
          <div class="search-wrap">
            <input id="searchInput" type="search" placeholder="Find a country or platform" autocomplete="off" aria-label="Find a country" />
            <div class="search-results" id="searchResults"></div>
          </div>
          <div class="mode-toggle" role="group" aria-label="Mode">
            <button type="button" id="btnView" class="active">View</button>
            <button type="button" id="btnEdit">Edit</button>
          </div>
          <div class="stat-pill"><b id="statCount">0</b> countries profiled</div>
        </div>

        <div class="map-card">
          <div id="mapWrap" class="map-wrap">
            <svg id="map" viewBox="0 0 1000 520" preserveAspectRatio="xMidYMid meet" role="img" aria-label="World map of digital identity models">
              <defs id="defs"></defs>
              <g id="zoomGroup"><g id="countryLayer"></g><g id="markerLayer"></g><g id="labelLayer"></g></g>
            </svg>
            <div id="atlasLoading" class="loading">Loading the map…</div>
            <div id="hintLayer"></div>
            <div class="zoom-hint" id="zoomHint"></div>
            <div class="zoom-controls">
              <button type="button" id="zoomIn" aria-label="Zoom in">+</button>
              <button type="button" id="zoomOut" aria-label="Zoom out">&minus;</button>
              <button type="button" id="zoomReset" aria-label="World view">&#8634;</button>
            </div>
            <div class="legend" id="legend"></div>
            <div class="edit-banner" id="editBanner">Edit mode: click any country to add or update its profile</div>
          </div>
          <aside id="drawer" class="drawer" aria-label="Country profile">
            <div class="drawer-head" id="drawerHead"></div>
            <div class="drawer-body" id="drawerBody"></div>
          </aside>
        </div>
        <div id="atlasTip" class="atlas-tip" role="tooltip"></div>
      </div>
    </div>
  </section>

  <section class="models">
    <div class="wrap models-stack">
      <div class="models-head">
        <div class="eyebrow">Reading the map</div>
        <h2 class="h2">Five ways countries identify people</h2>
      </div>
      <div class="models-grid">
        {models.map((m) => (
          <article class="model">
            <span class="model-sw" style={`background:${m.color}`}></span>
            <h3>{m.name}</h3>
            <p>{m.text}</p>
          </article>
        ))}
      </div>
      <p class="models-note">Compiled October 2026 from regional reports (South Asia, ASEAN, Latin America and the Caribbean, ID4D, DPI 2025) and public sources. Adoption figures should be confirmed against the primary source before external use.</p>
    </div>
  </section>
</Base>

<script>
  import '../scripts/atlas.js';
</script>

<style>
  .intro { padding: clamp(48px, 7vw, 96px) 0 clamp(32px, 4vw, 48px); }
  .intro-stack { display: flex; flex-direction: column; gap: 24px; }
  .atlas-section { padding: 0 0 clamp(72px, 10vw, 120px); }
  /* The map breaks out of the 1200px content column to use more of wide screens. */
  .wrap-wide { max-width: 1720px; }

  .models { background: var(--subtle); border-top: 1px solid var(--line); padding: clamp(72px, 10vw, 120px) 0; }
  .models-stack { display: flex; flex-direction: column; gap: clamp(32px, 4vw, 48px); }
  .models-head { display: flex; flex-direction: column; gap: 16px; max-width: 680px; }
  .models-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); gap: 16px; }
  .model { background: var(--surface); border: 1px solid var(--line); border-radius: 22px; padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .model-sw { width: 28px; height: 8px; border-radius: 4px; }
  .model h3 { font-size: 18px; line-height: 1.3; letter-spacing: -0.01em; }
  .model p { font-size: 15px; line-height: 1.55; color: var(--ink2); }
  .models-note { font-size: 14px; line-height: 1.55; color: var(--ink3); max-width: 760px; }
</style>

<style is:global>
  /* Elements inside #atlas are created at runtime, so these styles are global and scoped by .atlas. */
  .atlas {
    --a-bg: #F2F5F3; --a-land: #DCE3DF; --a-land-hover: #C9D3CD; --a-stroke: #FFFFFF;
    --a-label-stroke: #fff; --a-label: #1C334E; --a-hl: #E0306F;
    --a-ok: #1D995B; --a-pilot: #B98A0E; --a-prop: #D26A1F;
    position: relative; display: flex; flex-direction: column; gap: 14px;
  }
  @media (prefers-color-scheme: dark) {
    .atlas {
      --a-bg: #141A25; --a-land: #262F3F; --a-land-hover: #344054; --a-stroke: #10151F;
      --a-label-stroke: #10151F; --a-label: #EEF2F5; --a-hl: #FF4D8D;
      --a-ok: #5ABE82; --a-pilot: #E2B42B; --a-prop: #F0904A;
    }
  }
  .atlas button { font-family: inherit; }

  /* Toolbar */
  .atlas .toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .atlas .regions, .atlas .mode-toggle {
    display: flex; flex-wrap: wrap; gap: 2px; padding: 4px; border-radius: 999px;
    background: var(--subtle); border: 1px solid var(--line2);
  }
  .atlas .regions { margin-right: auto; }
  .atlas .regions button, .atlas .mode-toggle button {
    border: 0; background: transparent; color: var(--ink2); font-size: 14px; font-weight: 500;
    padding: 8px 14px; border-radius: 999px; cursor: pointer; display: flex; align-items: center; gap: 7px;
  }
  .atlas .regions button:hover, .atlas .mode-toggle button:hover { color: var(--ink); background: var(--mint); }
  .atlas .regions button.active, .atlas .mode-toggle button.active { background: var(--btn); color: var(--btn-ink); font-weight: 600; }
  .atlas .regions .cnt { font-size: 12px; padding: 1px 7px; border-radius: 999px; background: var(--mint); color: var(--pill); font-weight: 600; }
  .atlas .regions button.active .cnt { background: rgba(255,255,255,.18); color: inherit; }
  .atlas .search-wrap { position: relative; width: min(280px, 100%); }
  .atlas .search-wrap input {
    width: 100%; background: var(--surface); border: 1px solid var(--line2); color: var(--ink);
    padding: 11px 16px; border-radius: 999px; font: 500 14px var(--font-body); outline: none;
  }
  .atlas .search-wrap input:focus { border-color: var(--green-bright); box-shadow: 0 0 0 3px var(--mint); }
  .atlas .search-results {
    position: absolute; top: calc(100% + 6px); left: 0; right: 0; z-index: 60; display: none;
    background: var(--surface); border: 1px solid var(--line2); border-radius: 16px; padding: 6px;
    max-height: 320px; overflow-y: auto; box-shadow: 0 20px 40px rgba(16, 21, 31, .14);
  }
  .atlas .search-results.open { display: block; }
  .atlas .search-item {
    display: flex; align-items: center; gap: 10px; width: 100%; padding: 9px 10px; border: 0; border-radius: 10px;
    background: transparent; color: var(--ink); font-size: 14px; text-align: left; cursor: pointer;
  }
  .atlas .search-item:hover { background: var(--mint); }
  .atlas .search-item.none { color: var(--ink3); cursor: default; }
  .atlas .search-item img { width: 22px; height: 15px; object-fit: cover; border-radius: 3px; }
  .atlas .search-item .tag { margin-left: auto; font-size: 12px; color: var(--ink3); }
  .atlas .stat-pill { font-size: 14px; color: var(--ink2); padding: 9px 4px; white-space: nowrap; }
  .atlas .stat-pill b { font-family: var(--font-display); color: var(--green); font-size: 16px; }

  /* Map card */
  .atlas .map-card {
    position: relative; overflow: hidden; border-radius: 28px; border: 1px solid var(--line2);
    background: var(--a-bg); aspect-ratio: 1000 / 540; min-height: 480px; max-height: 86vh; width: 100%;
  }
  .atlas .map-wrap { position: absolute; inset: 0; cursor: grab; touch-action: none; }
  .atlas .map-wrap.grabbing { cursor: grabbing; }
  .atlas .map-wrap.edit-mode { cursor: crosshair; }
  .atlas svg#map { width: 100%; height: 100%; display: block; }
  .atlas .loading { position: absolute; inset: 0; display: grid; place-items: center; color: var(--ink3); font-size: 15px; }

  .atlas .country { fill: var(--a-land); stroke: var(--a-stroke); stroke-width: .6; vector-effect: non-scaling-stroke; cursor: pointer; transition: fill .12s, opacity .2s; }
  .atlas .country:hover { fill: var(--a-land-hover); }
  .atlas .country.has-data { stroke-width: .9; }
  .atlas .country.has-data:hover { filter: brightness(1.1) saturate(1.1); }
  .atlas .country.t-SSO { fill: #3B8FD9; } .atlas .country.t-MATCH { fill: #E8803A; } .atlas .country.t-VC-PKI { fill: #1D995B; } .atlas .country.t-VC-DLT { fill: #9466E0; } .atlas .country.t-HYBRID { fill: #E2B42B; }
  .atlas .country.pending.t-SSO { fill: url(#h-SSO); } .atlas .country.pending.t-MATCH { fill: url(#h-MATCH); } .atlas .country.pending.t-VC-PKI { fill: url(#h-VC-PKI); } .atlas .country.pending.t-VC-DLT { fill: url(#h-VC-DLT); } .atlas .country.pending.t-HYBRID { fill: url(#h-HYBRID); }
  .atlas svg.focus .country, .atlas svg.focus .mk { opacity: .3; }
  .atlas svg.focus .country.sel, .atlas svg.focus .mk.sel { opacity: 1; }
  .atlas svg.filtered .country.prop-match { opacity: .85; stroke: var(--ink); stroke-dasharray: 2 1.5; }
  .atlas svg.filtered .country.has-data:not(.match-filter), .atlas svg.filtered .mk:not(.match-filter) { opacity: .18; }
  .atlas .country.sel { fill: var(--a-hl) !important; stroke: #fff !important; stroke-width: 2 !important; filter: drop-shadow(0 0 5px var(--a-hl)); }
  .atlas .mk circle.dot { stroke: var(--a-stroke); stroke-width: 1; vector-effect: non-scaling-stroke; cursor: pointer; }
  .atlas .mk circle.ring { fill: none; stroke-width: 1.2; vector-effect: non-scaling-stroke; opacity: .75; pointer-events: none; }
  .atlas .mk.sel circle.dot { fill: var(--a-hl) !important; stroke: #fff; stroke-width: 2; }
  .atlas .mk.sel circle.ring { stroke: var(--a-hl); opacity: 1; }
  .atlas .country-label { font-family: var(--font-body); font-weight: 600; fill: var(--a-label); text-anchor: middle; pointer-events: none; paint-order: stroke; stroke: var(--a-label-stroke); stroke-linejoin: round; opacity: 0; transition: opacity .2s; }
  .atlas svg.zoomed .country-label.on { opacity: 1; }

  .atlas .region-hint {
    position: absolute; z-index: 18; transform: translate(-50%, -50%); display: flex; align-items: center; gap: 8px;
    background: var(--surface); border: 1px solid var(--line2); color: var(--ink); font-size: 13px;
    padding: 7px 14px 7px 8px; border-radius: 999px; cursor: pointer; white-space: nowrap;
    box-shadow: 0 8px 24px rgba(16, 21, 31, .12); animation: atlasPulse 2.4s infinite; transition: opacity .25s;
  }
  .atlas .region-hint:hover { background: var(--btn); color: var(--btn-ink); border-color: var(--btn); }
  .atlas .region-hint .z { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; background: var(--green-bright); color: #fff; font-weight: 700; font-size: 14px; }
  .atlas .region-hint b { font-weight: 600; }
  .atlas .region-hint.hide { opacity: 0; pointer-events: none; }
  @keyframes atlasPulse { 0% { box-shadow: 0 0 0 0 rgba(29, 153, 91, .4); } 70% { box-shadow: 0 0 0 12px rgba(29, 153, 91, 0); } 100% { box-shadow: 0 0 0 0 rgba(29, 153, 91, 0); } }
  @media (prefers-reduced-motion: reduce) { .atlas .region-hint { animation: none; } }
  .atlas .zoom-hint {
    position: absolute; top: 16px; left: 50%; transform: translateX(-50%); z-index: 19; max-width: calc(100% - 32px);
    background: var(--surface); border: 1px solid var(--line); border-radius: 999px; font-size: 13px; color: var(--ink2);
    padding: 8px 16px; pointer-events: none; text-align: center; box-shadow: 0 4px 14px rgba(16, 21, 31, .06);
  }
  .atlas .zoom-hint b { color: var(--ink); font-weight: 600; }

  .atlas .zoom-controls { position: absolute; right: 16px; bottom: 16px; z-index: 20; display: flex; flex-direction: column; gap: 2px; background: var(--surface); border: 1px solid var(--line2); border-radius: 14px; padding: 4px; }
  .atlas .zoom-controls button { width: 38px; height: 38px; border-radius: 10px; border: 0; background: transparent; color: var(--ink); font-size: 18px; cursor: pointer; }
  .atlas .zoom-controls button:hover { background: var(--mint); }

  .atlas .legend {
    position: absolute; left: 16px; bottom: 16px; z-index: 20; max-width: 430px;
    background: var(--surface); border: 1px solid var(--line2); border-radius: 18px; padding: 14px; font-size: 13px; color: var(--ink2);
  }
  .atlas .legend h4 { margin: 0 0 8px 6px; font: 600 12px var(--font-body); letter-spacing: .12em; text-transform: uppercase; color: var(--green); }
  .atlas .legend h4 span { letter-spacing: 0; text-transform: none; color: var(--ink3); font-weight: 500; margin-left: 6px; }
  .atlas .legend .row { display: flex; align-items: center; gap: 10px; width: 100%; padding: 5px 6px; border: 0; border-radius: 8px; background: transparent; color: var(--ink); font-size: 13px; text-align: left; cursor: pointer; }
  .atlas .legend .row:hover { background: var(--mint); }
  .atlas .legend .row.off { opacity: .35; }
  .atlas .legend .sw { width: 14px; height: 14px; border-radius: 4px; flex-shrink: 0; display: inline-block; }
  .atlas .legend .n { margin-left: auto; padding-left: 10px; font-size: 12px; color: var(--ink3); white-space: nowrap; font-weight: 600; }
  .atlas .legend .n i { font-style: normal; font-weight: 500; }
  .atlas .legend .n i.pr { color: var(--a-prop); }
  .atlas .legend .foot { display: flex; gap: 16px; margin-top: 8px; padding: 8px 6px 0; border-top: 1px solid var(--line); font-size: 12px; }
  .atlas .legend .foot span { display: flex; align-items: center; gap: 6px; }
  .atlas .sw.hatch { background: repeating-linear-gradient(45deg, var(--ink3) 0 2px, transparent 2px 5px); border: 1px solid var(--ink3); }
  .atlas .sw.solid { background: var(--ink3); }

  .atlas .edit-banner { position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%); z-index: 21; background: var(--btn); color: var(--btn-ink); font-size: 13px; font-weight: 600; padding: 9px 16px; border-radius: 999px; display: none; }
  .atlas .edit-banner.show { display: block; }

  /* Tooltip */
  .atlas-tip { position: fixed; z-index: 80; pointer-events: none; width: 290px; background: var(--surface); border: 1px solid var(--line2); border-radius: 16px; overflow: hidden; box-shadow: 0 20px 50px rgba(16, 21, 31, .18); display: none; }
  .atlas-tip.show { display: block; }
  .atlas .tt-head { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-bottom: 1px solid var(--line); }
  .atlas .tt-head img { width: 32px; height: 22px; object-fit: cover; border-radius: 4px; box-shadow: 0 0 0 1px var(--line2); }
  .atlas .tt-head .nm { font-family: var(--font-display); font-weight: 600; font-size: 16px; color: var(--ink); }
  .atlas .tt-body { padding: 10px 14px 13px; font-size: 13px; line-height: 1.5; color: var(--ink2); }
  .atlas .tt-body .chips { margin-bottom: 4px; }
  .atlas .tt-body .k { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; color: var(--green); margin-top: 8px; }

  .atlas .chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .atlas .chip { display: inline-flex; align-items: center; font-size: 12px; padding: 4px 10px; border-radius: 999px; font-weight: 600; color: var(--ink); background: color-mix(in srgb, var(--c) 20%, transparent); border: 1px solid color-mix(in srgb, var(--c) 55%, transparent); }
  .atlas .chip.status { background: transparent; border: 1px solid var(--line2); color: var(--ink2); }
  .atlas .chip.status.Production { border-color: var(--a-ok); color: var(--a-ok); }
  .atlas .chip.status.Pilot { border-color: var(--a-pilot); color: var(--a-pilot); }
  .atlas .chip.status.Proposed { border-color: var(--a-prop); color: var(--a-prop); }

  /* Drawer */
  .atlas .drawer {
    position: absolute; top: 0; right: 0; bottom: 0; z-index: 40; width: 460px; max-width: 100%;
    background: var(--surface); border-left: 1px solid var(--line2); box-shadow: -24px 0 60px rgba(16, 21, 31, .12);
    transform: translateX(105%); transition: transform .25s cubic-bezier(.2, .8, .2, 1); display: flex; flex-direction: column;
  }
  .atlas .drawer.open { transform: translateX(0); }
  .atlas .drawer-head { padding: 20px 22px; border-bottom: 1px solid var(--line); display: flex; gap: 14px; align-items: flex-start; }
  .atlas .drawer-head .flag { width: 60px; height: 40px; object-fit: cover; border-radius: 6px; box-shadow: 0 0 0 1px var(--line2); flex-shrink: 0; }
  .atlas .a-eyebrow { margin: 0; font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--green); }
  .atlas .drawer-head h2 { margin: 4px 0 10px; font-size: 24px; letter-spacing: -.02em; color: var(--ink); }
  .atlas .drawer-close { margin-left: auto; flex-shrink: 0; width: 36px; height: 36px; border-radius: 10px; border: 1px solid var(--line2); background: var(--surface); color: var(--ink2); font-size: 14px; cursor: pointer; }
  .atlas .drawer-close:hover { color: var(--ink); background: var(--mint); }
  .atlas .drawer-body { flex: 1; overflow-y: auto; padding: 18px 22px 28px; }
  .atlas .drawer-body .empty { color: var(--ink2); font-size: 15px; line-height: 1.6; margin-bottom: 16px; }

  .atlas .gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 18px; }
  .atlas .gallery .shot { aspect-ratio: 4 / 3; border-radius: 12px; overflow: hidden; background: var(--subtle); border: 1px solid var(--line); }
  .atlas .gallery .shot img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .atlas .gallery .shot.full { grid-column: 1 / -1; aspect-ratio: auto; }
  .atlas .gallery .shot.full img { max-height: 240px; }
  .atlas .gal-cap { grid-column: 1 / -1; font-size: 12px; color: var(--ink3); }

  .atlas dl.facts { margin: 0; }
  .atlas dl.facts dt { font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--green); margin: 18px 0 6px; }
  .atlas dl.facts dt:first-child { margin-top: 0; }
  .atlas dl.facts dd { margin: 0; font-size: 15px; line-height: 1.6; color: var(--ink); }
  .atlas dl.facts dd ul { margin: 0; padding-left: 18px; }
  .atlas dl.facts dd li { margin-bottom: 4px; }
  .atlas dl.facts dd li::marker { color: var(--green-bright); }
  .atlas dl.facts .none { color: var(--ink3); }
  .atlas .type-box { border-radius: 16px; padding: 14px; background: var(--mint); }
  .atlas .type-box .def { font-size: 14px; color: var(--ink2); margin-top: 8px; line-height: 1.5; }
  .atlas .type-box .k2 { font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--green); margin-top: 12px; }
  .atlas .comps { display: flex; flex-direction: column; gap: 7px; margin-top: 7px; }
  .atlas .comp { display: flex; gap: 9px; align-items: flex-start; font-size: 13px; line-height: 1.4; }
  .atlas .comp.fut { opacity: .6; }
  .atlas .comp b { color: var(--ink); font-weight: 600; }
  .atlas .cdot { width: 10px; height: 10px; border-radius: 3px; margin-top: 4px; flex-shrink: 0; }
  .atlas .cst { font-size: 11px; margin-left: 6px; padding: 1px 7px; border: 1px solid var(--line2); border-radius: 999px; color: var(--ink2); }
  .atlas .csys { color: var(--ink2); }
  .atlas .summary p { margin: 0 0 10px; }
  .atlas .summary strong { color: var(--ink); font-weight: 600; }
  .atlas .links a { color: var(--green); text-decoration: none; font-weight: 500; word-break: break-word; }
  .atlas .links a:hover { text-decoration: underline; }
  .atlas .links .u { display: block; font-size: 12px; color: var(--ink3); word-break: break-all; }
  .atlas .note { margin-top: 20px; padding-top: 12px; border-top: 1px solid var(--line); font-size: 12px; line-height: 1.5; color: var(--ink3); }

  /* Buttons and forms (prefixed so they don't collide with the site's .btn) */
  .atlas .a-btn { display: inline-flex; align-items: center; justify-content: center; padding: 11px 20px; border-radius: 999px; border: 0; cursor: pointer; font-size: 14px; font-weight: 600; }
  .atlas .a-btn-primary { background: var(--btn); color: var(--btn-ink); }
  .atlas .a-btn-primary:hover { background: #348454; color: #fff; }
  .atlas .a-btn-ghost { background: transparent; color: var(--ink); border: 1.5px solid var(--btn); }

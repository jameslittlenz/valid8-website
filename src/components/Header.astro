---
import { u } from '../url';
import Logo from './Logo.astro';
import { navLinks, type NavId } from '../data/site';

interface Props { active?: NavId }
const { active = 'home' } = Astro.props;
---
<header class="site-header" data-open="false">
  <div class="wrap bar">
    <a href={u("/")} class="home-link"><Logo height="calc(76px - var(--shrink))" /></a>

    <div class="wide">
      <nav aria-label="Main">
        {navLinks.map((l) => (
          <a href={u(l.href)} class:list={['nav-link', { active: l.id === active }]} aria-current={l.id === active ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
      <a href="#contact" class="cta">Get in touch</a>
    </div>

    <button class="menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
      <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="close" aria-hidden="true">×</span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu">
    <a href={u("/")} class:list={['m-link', { active: active === 'home' }]}>Home</a>
    {navLinks.map((l) => (
      <a href={u(l.href)} class:list={['m-link', { active: l.id === active }]}>{l.label}{l.id === active && <span class="dot" />}</a>
    ))}
    <a href="#contact" class="m-cta">Get in touch</a>
  </div>
</header>

<script is:inline>
  // Set the logo size before first paint so it doesn't jump on load.
  document.querySelector('.site-header').style.setProperty('--shrink', Math.min(scrollY, 38) + 'px');
</script>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const btn = header.querySelector<HTMLButtonElement>('.menu-btn')!;
  const setOpen = (open: boolean) => {
    header.dataset.open = String(open);
    btn.setAttribute('aria-expanded', String(open));
  };
  btn.addEventListener('click', () => setOpen(header.dataset.open !== 'true'));
  header.querySelectorAll('.mobile-menu a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  matchMedia('(min-width: 960px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });

  // The logo starts at double size and shrinks over the first 38px of scroll.
  let ticking = false;
  const update = () => {
    header.style.setProperty('--shrink', `${Math.min(scrollY, 38)}px`);
    ticking = false;
  };
  addEventListener('scroll', () => {
    if (!ticking) { ticking = true; requestAnimationFrame(update); }
  }, { passive: true });
  update();
</script>

<style>
  /* The header is 38px taller than the bar it settles into and sticks at
     top: -38px, so it keeps a constant height in the page while the extra
     38px scrolls away. --shrink (0 to 38px, set from scrollY) pads the bar
     down and shortens it to match, keeping its contents centred in what's
     visible as the logo shrinks from 76px to 38px. Without JS it stays compact. */
  .site-header {
    --shrink: 38px;
    position: sticky; top: -38px; z-index: 50; padding-top: var(--shrink);
    background: var(--hdr);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .bar { height: calc(114px - var(--shrink)); display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .home-link { display: flex; align-items: center; flex: none; }

  .wide { display: none; align-items: center; gap: 14px; }
  .wide nav { display: flex; align-items: center; gap: 4px; }
  .nav-link {
    position: relative; padding: 10px 14px; border-radius: 8px;
    font-size: 15px; font-weight: 500; color: var(--ink); text-decoration: none; white-space: nowrap;
  }
  .nav-link:hover { background: var(--mint); color: var(--ink); }
  .nav-link.active::after {
    content: ''; position: absolute; left: 14px; right: 14px; bottom: 3px;
    height: 2px; border-radius: 2px; background: var(--green-bright);
  }
  .cta {
    display: inline-flex; align-items: center; gap: 8px; padding: 11px 20px; border-radius: 999px;
    background: var(--btn); color: var(--btn-ink); font-size: 15px; font-weight: 600;
    text-decoration: none; white-space: nowrap; flex: none;
  }
  .cta:hover { background: #348454; color: var(--btn-ink); }

  .menu-btn {
    width: 44px; height: 44px; border: 1px solid var(--line2); border-radius: 12px;
    background: var(--surface); display: flex; align-items: center; justify-content: center;
    cursor: pointer; padding: 0; color: var(--ink);
  }
  .bars { display: flex; flex-direction: column; gap: 5px; }
  .bars span { width: 18px; height: 2px; background: var(--ink); border-radius: 2px; display: block; }
  .close { display: none; font-size: 22px; line-height: 1; }
  [data-open='true'] .bars { display: none; }
  [data-open='true'] .close { display: block; }

  .mobile-menu {
    display: none; border-top: 1px solid var(--line); background: var(--surface);
    padding: 12px var(--gutter) 24px; flex-direction: column; gap: 4px;
  }
  [data-open='true'] .mobile-menu { display: flex; }
  .m-link {
    padding: 14px 4px; font-family: var(--font-display); font-size: 22px; font-weight: 600;
    color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--line);
    display: flex; justify-content: space-between; align-items: center;
  }
  .m-link:hover { color: var(--ink); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green-bright); }
  .m-cta {
    margin-top: 16px; display: flex; justify-content: center; padding: 15px 20px; border-radius: 999px;
    background: var(--btn); color: var(--btn-ink); font-size: 16px; font-weight: 600; text-decoration: none;
  }
  .m-cta:hover { color: var(--btn-ink); }

  @media (min-width: 960px) {
    .wide { display: flex; }
    .menu-btn, .mobile-menu, [data-open='true'] .mobile-menu { display: none; }
  }
</style>
